# PeerPod Frontend environment
# Copy to `.env.local` for local development (never commit secrets).

# ---------------------------------------------------------------------------
# Server-only (used by Next.js BFF / rewrites — NOT exposed to the browser)
# ---------------------------------------------------------------------------

# Backend API origin the BFF proxies to
API_BASE_URL=http://localhost:3001

# Comma-separated extra browser origins allowed for auth CSRF checks.
# The request's own host is always allowed automatically.
# Useful for LAN testing: http://192.168.x.x:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Optional public vars (exposed to the browser)
# ---------------------------------------------------------------------------

# Leave EMPTY to use the same-origin Socket.IO proxy (recommended).
# That avoids browser CORS entirely: browser -> Next (:3000) -> backend (:3001).
# Only set this if you intentionally connect the browser straight to the backend
# AND the backend CORS allowlist includes your frontend origin.
# NEXT_PUBLIC_SOCKET_URL=

# Optional explicit public app origin (rarely needed; host is inferred from the request).
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
